connection:
  real:
    url: postgres://user:pass@localhost:5432/mydb
  shadow:
    key: autodb             # shadow schema naming key: {source_schema}_{key}

llm:
  provider: ollama        # ollama | openai | custom
  model: llama3.2         # model name
  base_url: http://localhost:11434/v1
  api_key: ""             # required for cloud providers

generation:
  default_rows: 100
  seed: 42
  tables:
    users:
      rows: 500
      columns:
        bio:
          generator: llm
          prompt: "Write a short professional bio"
        role:
          generator: one_of
          values: ["admin", "user", "moderator"]
    orders:
      rows: 2000
  column_rules:
    - pattern: "*_sku"
      generator: regex
      format: "[A-Z]{3}-[0-9]{6}"
